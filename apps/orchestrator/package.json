{
  "name": "@ampda/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup src/index.ts --format esm,cjs",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx src/test-runtime.ts",
    "clean": "rimraf dist",
    "lint": "echo \"No lint configured\""
  },
  "dependencies": {
    "@ampda/config": "workspace:*",
    "@ampda/core": "workspace:*",
    "@ampda/job-engine": "workspace:*",
    "@ampda/agent-runtime": "workspace:*",
    "@ampda/openai-provider": "workspace:*",
    "@ampda/project-export": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
