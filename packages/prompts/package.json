{
  "name": "@ampda/prompts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "agents",
    "packs",
    "quality",
    "system",
    "workflows"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup src/index.ts --format esm,cjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
