{
    "name":  "@ampda/workflow-engine",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "main":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "files":  [
                  "dist"
              ],
    "scripts":  {
                    "build":  "pnpm run build:js \u0026\u0026 pnpm run build:types",
                    "build:js":  "tsup",
                    "build:types":  "tsc -p tsconfig.build.json --emitDeclarationOnly",
                    "dev":  "tsup --watch",
                    "clean":  "rimraf dist",
                    "lint":  "echo \"No lint configured\"",
                    "test":  "echo \"No tests configured\""
                },
    "dependencies":  {
                         "@ampda/core":  "workspace:*",
                         "@ampda/job-engine":  "workspace:*"
                     },
    "devDependencies":  {
                            "@types/node":  "^24.13.3",
                            "rimraf":  "^6.1.3",
                            "tsup":  "^8.5.1",
                            "tsx":  "^4.23.12",
                            "typescript":  "^5.9.3"
                        },
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "require":  "./dist/index.cjs"
                          }
                }
}
