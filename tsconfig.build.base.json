{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "noEmit": false
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/test-*.ts",
    "**/dist",
    "**/node_modules"
  ]
}
